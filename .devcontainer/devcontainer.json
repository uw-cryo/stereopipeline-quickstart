{
  "name": "stereopipeline-quickstart",

  // Pull the pre-built image from GHCR. CI builds and pushes this image on
  // every change to the Dockerfile / environment.yml — see
  // .github/workflows/build-image.yml.
  //
  // First-launch time drops from ~5 min (build) to ~30-90 s (pull) because
  // ASP binaries + the conda env are already baked in.
  "image": "ghcr.io/bpurinton/stereopipeline-quickstart:latest",

  // Local-build fallback — uncomment this `build:` block (and comment out the
  // `image:` line above) if you've forked the repo and don't have access to
  // the bpurinton/* GHCR namespace, or want to rebuild offline. Note the
  // context: ".." — it makes the build context the repo root so the
  // Dockerfile's `COPY .devcontainer/environment.yml ...` resolves correctly.
  //
  // "build": {
  //   "dockerfile": "Dockerfile",
  //   "context": "..",
  //   "args": {
  //     "ASP_VERSION": "3.7.0",
  //     "ASP_BUILD_DATE": "2026-06-08"
  //   }
  // },

  // Codespace machine size — these are MINIMUMS; GitHub will refuse smaller
  // machines at launch. 4 cores is the floor every GitHub account can launch
  // without extra billing setup (see issue #3); 8/16-core options require
  // a payment method + spending limit on the personal account, which is an
  // unacceptable blocker for a learning resource. Stereo correlation is
  // parallel and will be ~2x faster on 8 cores — users on larger machines
  // can bump the --processes / --threads-multiprocess flags in the notebooks
  // to take advantage.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "redhat.vscode-yaml",
        "executablebookproject.myst-highlight",
        "mathematic.vscode-pdf"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/asp/bin/python",
        "jupyter.jupyterServerType": "local",
        // VS Code doesn't auto-select a kernel for a notebook it hasn't
        // opened before, so the first Run All asks for one. Hide every
        // Python but the asp env, so it is the only one to choose.
        "jupyter.kernels.excludePythonEnvironments": [
          "/opt/conda/bin/python",
          "/opt/StereoPipeline/bin/python",
          "/usr/bin/python3"
        ],
        // Always open notebooks in the notebook editor, including the one
        // postAttach.sh opens.
        "workbench.editorAssociations": {
          "*.ipynb": "jupyter-notebook"
        },
        // Pop-ups a first-time learner doesn't need on launch.
        "redhat.telemetry.enabled": false,
        "extensions.ignoreRecommendations": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        // Start with the terminal panel closed; the notebooks don't need it.
        "terminal.integrated.hideOnStartup": "always",
        "files.watcherExclude": {
          "**/data/**": true,
          "**/.ipynb_checkpoints/**": true
        },
        // Hide infrastructure from the file explorer so first-time learners
        // in a Codespace see only notebooks/ + data/. These live here (as
        // Codespace-only Remote settings) rather than in .vscode/settings.json
        // so local development still shows the full tree.
        "files.exclude": {
          ".github": true,
          ".devcontainer": true,
          ".vscode": true,
          "docs": true,
          ".readthedocs.yaml": true,
          "requirements.txt": true,
          ".gitignore": true,
          "architecture": true,
          "AGENTS.md": true,
          "ARCHITECTURE.md": true,
          "CLAUDE.md": true,
          "LICENSE": true,
          // Written next to notebooks/utils.py when a notebook imports it.
          "**/__pycache__": true
        }
      }
    }
  },

  // Run a one-time setup the first time the container is created. onCreateCommand,
  // not postCreateCommand, because Codespaces prebuilds run only the former, so
  // a prebuild includes these downloads. This pre-fetches
  // the ASTER Zenodo archive (~45 MB) and its shipped ICESat-2 data (~18 MB)
  // so the first notebook is instant.
  // The WorldView download is heavier and is deferred to the notebook itself.
  "onCreateCommand": "bash .devcontainer/onCreate.sh",

  // Open Tutorial 1 once VS Code is attached and the folder is trusted.
  // customizations.codespaces.openFiles opened it before the trust prompt,
  // in Restricted Mode, where it showed as raw JSON.
  "postAttachCommand": "bash .devcontainer/postAttach.sh",

  "remoteUser": "vscode",

  // Forward Jupyter port for users who launch a standalone Jupyter server.
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "ignore"
    }
  }
}
